library(decontam); packageVersion("decontam")
library(ggplot2); packageVersion("ggplot2")
library(data.table)
library(dplyr)
library(stringr)
ASV_feature_table <- fread("/Users/spencertoth/Desktop/Research/canine_skin_project/R_visualizations/input_csv_files/canine_skin_microbiome_filtered_nochim_asvs_names.csv", header=TRUE)
sample_metadata <- read.delim("/Users/spencertoth/Desktop/Research/canine_skin_project/R_visualizations/input_csv_files/metadata/CH-All_16S_Metadata_20220124.tsv", header=TRUE)
sample_DNA_library_CH1 <- read.csv("/Users/spencertoth/Desktop/Research/canine_skin_project/R_visualizations/input_csv_files/metadata/CH1-4_PoolCalcs.xlsx - CH1_Pool Calc.csv")
sample_DNA_library_CH2 <- read.csv("/Users/spencertoth/Desktop/Research/canine_skin_project/R_visualizations/input_csv_files/metadata/CH1-4_PoolCalcs.xlsx - CH2_Pool Calc.csv")
sample_DNA_library_CH3 <- read.csv("/Users/spencertoth/Desktop/Research/canine_skin_project/R_visualizations/input_csv_files/metadata/CH1-4_PoolCalcs.xlsx - CH3_Pool Calc.csv")
sample_DNA_library_CH4 <- read.csv("/Users/spencertoth/Desktop/Research/canine_skin_project/R_visualizations/input_csv_files/metadata/CH1-4_PoolCalcs.xlsx - CH4_Pool Calc.csv")
rownames(ASV_feature_table) <- ASV_feature_table$V1
rownames(sample_metadata) <- sample_metadata$SampleID
# Confirm identical samples
identical(sort(rownames(sample_metadata)), sort(rownames(ASV_feature_table)))
table(sample_metadata$Sample_Site, useNA="ifany")
# Merge DNA library concentrations to 16S metadata
all_libraries_clean <- bind_rows(
sample_DNA_library_CH1,
sample_DNA_library_CH2,
sample_DNA_library_CH3,
sample_DNA_library_CH4
) %>%
# 2. Select columns & clean strings
mutate(
# Remove "-16S" from the Sample string
Sample = str_remove(Sample, "-16S"),
# Remove "uL" from the volume column, trim spaces, and convert to numeric
uL.to.get.200nM = str_remove(uL.to.get.200nM, "uL"),
uL.to.get.200nM = str_trim(uL.to.get.200nM),
uL.to.get.200nM = as.numeric(uL.to.get.200nM)
) %>%
select(Sample, uL.to.get.200nM) %>%
distinct(Sample, .keep_all = TRUE)
# 3. Merge cleanly into your master sample metadata
merged_df <- sample_metadata %>%
select(-any_of("uL.to.get.200nM")) %>%
left_join(all_libraries_clean, by = c("SampleID" = "Sample"))
merged_df
