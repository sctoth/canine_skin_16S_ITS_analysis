df.asv <- data.frame(Sequence=colnames(ASV_feature_table_subset),
Prevalence=colSums((ASV_feature_table_subset)>0), # number of samples with a given ASV (prevalence)
Prevalence.Pos=colSums(((ASV_feature_table_subset)[!sample_metadata_subset$NegativeControl,]>0)),
